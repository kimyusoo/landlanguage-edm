# ─────────────────────────────────────────────────────────────────────────────
# LAND LANGUAGE — AI REAL ESTATE BRIEF  ·  환경변수 예시
# 이 파일을 .env 로 복사하세요:  cp .env.example .env
# 값이 비어 있으면 해당 어댑터는 자동으로 Mock Mode 로 동작합니다.
# 즉, 아무 키 없이도 `npm run dev` 로 전체 화면/워크플로를 확인할 수 있습니다.
# ─────────────────────────────────────────────────────────────────────────────

# 앱 공개 URL (UTM/수신거부/링크 생성에 사용)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI Provider (Adapter) ────────────────────────────────────────────────────
# AI_PROVIDER: mock | anthropic | openai        (기본값: mock)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Email Provider (Adapter) ─────────────────────────────────────────────────
# EMAIL_PROVIDER: mock | resend | ses | sendgrid   (기본값: mock)
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM="홍길동부동산 <brief@landlanguage.example>"
# Amazon SES
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SendGrid
SENDGRID_API_KEY=

# ── KakaoTalk (공식 채널/비즈메시지 Adapter) ─────────────────────────────────
# KAKAO_PROVIDER: mock | bizmessage            (기본값: mock)
# 개인 카카오 계정 자동화/매크로는 사용하지 않습니다. 공식 API 만 연동합니다.
KAKAO_PROVIDER=mock
KAKAO_API_KEY=
KAKAO_CHANNEL_ID=
KAKAO_SENDER_KEY=
KAKAO_PLUS_FRIEND_ID=

# ── Database (프로덕션 경로) ─────────────────────────────────────────────────
# DATA_BACKEND: mock | prisma                   (기본값: mock)
# mock 이면 인메모리 시드 데이터로 구동되어 DB 가 필요 없습니다.
DATA_BACKEND=mock
DATABASE_URL="postgresql://user:password@localhost:5432/land_language?schema=public"

# ── 관리자 인증 (간단 게이트) ───────────────────────────────────────────────
ADMIN_EMAIL=admin@landlanguage.example
ADMIN_PASSWORD=changeme
AUTH_SECRET=please-change-this-to-a-long-random-string

# ── 스케줄러 / Cron ─────────────────────────────────────────────────────────
# 외부 크론(예: Vercel Cron)이 /api/cron/* 를 호출할 때 사용할 시크릿
CRON_SECRET=please-change-this-cron-secret

# ── 자동 발송 안전장치 (기본값 false — 관리자 승인 후에만 발송) ─────────────
AUTO_SEND=false
